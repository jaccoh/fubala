# Fubala backend configuration (copy to .env and fill in what you have).
# Provider API keys — a provider appears as "configured" in the model
# catalog only when its key is present. Add only what you use.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# Custom OpenAI-compatible endpoints (optional overrides)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Fubala settings (all optional; see app/config.py)
# FUBALA_DATABASE_PATH=data/fubala.db
# FUBALA_DEFAULT_MODEL=echo/dev
# FUBALA_CORS_ORIGINS=["http://localhost:5173"]
